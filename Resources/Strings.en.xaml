    <sys:String x:Key="PowerProfile_Cooling_Name">CryoTray — Cooling</sys:String>
    <sys:String x:Key="PowerProfile_Cooling_Badge">Default</sys:String>
    <sys:String x:Key="PowerProfile_Cooling_Description">Maximum cooling &amp; quiet operation. Disables CPU Turbo Boost and softens clock spikes to drop temps and wattage during browsing, downloads, and light tasks.</sys:String>
    <sys:String x:Key="PowerProfile_Balanced_Name">Windows Balanced</sys:String>
    <sys:String x:Key="PowerProfile_Balanced_Badge">Windows Default</sys:String>
    <sys:String x:Key="PowerProfile_Balanced_Description">Standard Windows power plan. Balances performance and power without CryoTray tuning. Used when Cooling Mode is off unless you pick a CryoTray gaming profile.</sys:String>
    <sys:String x:Key="PowerProfile_Legacy_Name">CryoTray Cooling - Legacy</sys:String>
    <sys:String x:Key="PowerProfile_Legacy_Badge">Classic</sys:String>
    <sys:String x:Key="PowerProfile_Legacy_Description">CryoTray's classic cooling tuning. Disables Turbo Boost to lower temperatures while keeping snappy base-clock responsiveness (0% AC EPP, all cores unparked).</sys:String>
    <sys:String x:Key="PowerProfile_GamingLow_Name">CryoTray — Gaming (Low)</sys:String>
    <sys:String x:Key="PowerProfile_GamingLow_Badge">Cool Gaming</sys:String>
    <sys:String x:Key="PowerProfile_GamingLow_Description">Cool &amp; efficient gaming. Uses conservative Efficient Boost with all cores active—great for esports, indie games, or keeping laptop temps low.</sys:String>
    <sys:String x:Key="PowerProfile_GamingMedium_Name">CryoTray — Gaming (Medium)</sys:String>
    <sys:String x:Key="PowerProfile_GamingMedium_Badge">Balanced</sys:String>
    <sys:String x:Key="PowerProfile_GamingMedium_Description">Balanced AAA gaming. Delivers smooth frame rates with Efficient Aggressive boost while avoiding unnecessary heat and power spikes.</sys:String>
    <sys:String x:Key="PowerProfile_GamingHigh_Name">CryoTray — Gaming (High)</sys:String>
    <sys:String x:Key="PowerProfile_GamingHigh_Badge">Full Boost</sys:String>
    <sys:String x:Key="PowerProfile_GamingHigh_Description">Full uncapped gaming performance. Unlocks full CPU Boost, disables PCIe/USB/NVMe power saving to prevent stutters, and lets the CPU rest when idle.</sys:String>
    <sys:String x:Key="PowerProfile_GamingUltimate_Name">CryoTray — Gaming (Ultimate)</sys:String>
    <sys:String x:Key="PowerProfile_GamingUltimate_Badge">Zero Latency</sys:String>
    <sys:String x:Key="PowerProfile_GamingUltimate_Description">Maximum responsiveness &amp; zero clock-ramp delay. Locks CPU clocks at 100% minimum state with Aggressive Boost for competitive play and benchmarks (highest heat/power).</sys:String>
