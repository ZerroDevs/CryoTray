    <sys:String x:Key="StorageCleanup_TempTitle">User &amp; System Temporary Files</sys:String>
    <sys:String x:Key="StorageCleanup_TempDesc">Removes leftover installer, game-update, and app temp files (%temp% and Windows\Temp). Skips files that are currently in use.</sys:String>
    <sys:String x:Key="StorageCleanup_BrowserTitle">Web Browser Cache</sys:String>
    <sys:String x:Key="StorageCleanup_BrowserDesc">Clears cached images and web scripts (Chrome, Edge, Brave, Firefox, Opera, Opera GX). Passwords, cookies, logins, bookmarks, and history are never touched.</sys:String>
    <sys:String x:Key="StorageCleanup_GpuTitle">GPU &amp; DirectX Shader Cache</sys:String>
    <sys:String x:Key="StorageCleanup_GpuDesc">Clears compiled NVIDIA, AMD, Intel, and DirectX shader caches. Caches rebuild on first launch and may cause brief stutter. Useful after GPU driver updates.</sys:String>
    <sys:String x:Key="StorageCleanup_CrashTitle">Crash Dumps &amp; Error Reports</sys:String>
    <sys:String x:Key="StorageCleanup_CrashDesc">Clears Windows and app crash dumps plus error report archives (%LocalAppData%\CrashDumps, Minidump, and WER). Safe to remove after troubleshooting.</sys:String>
    <sys:String x:Key="StorageCleanup_PrefetchTitle">Windows Prefetch Files</sys:String>
    <sys:String x:Key="StorageCleanup_PrefetchDesc">Not recommended for routine cleanup: Windows uses Prefetch to launch apps and games faster. Clearing it causes temporary slower cold starts.</sys:String>
    <sys:String x:Key="StorageCleanup_SkipRecentTemp">Skip temp files newer than 24 hours</sys:String>
    <sys:String x:Key="StorageCleanup_SkipRecentTempTooltip">Protects recently staged installer, patch, and app temp files modified within the last 24 hours. Uncheck to clean all unlocked temp files.</sys:String>
