<Window x:Class="CryoTray.Views.StartupManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StartupManager_Title}"
        Width="560"
        Height="640"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Images/CryoTray.ico"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ManagerActionBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBdr" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BtnBdr" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManagerFilterBtn" TargetType="Button" BasedOn="{StaticResource ManagerActionBtn}">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style x:Key="ManagerCloseBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBdr" Property="Background" Value="{DynamicResource DangerSoftBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBdr" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManagerComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MenuHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource SelectionTextBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="BoxBdr"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="4">
                                            <Grid Margin="8,0,6,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1"
                                                      Data="M0,0 L4,4 L8,0"
                                                      Stroke="{DynamicResource TextSecondaryBrush}"
                                                      StrokeThickness="1.4"
                                                      VerticalAlignment="Center"
                                                      Margin="6,1,0,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BoxBdr" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="9,0,24,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   FlowDirection="LeftToRight"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="240"
                                        Background="{DynamicResource MenuBackgroundBrush}"
                                        BorderBrush="{DynamicResource MenuBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ManagerScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Margin" Value="0,4,2,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Width="5"
                                                        Background="{DynamicResource TextMutedBrush}"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CompactCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="14" Height="14"
                                    CornerRadius="2"
                                    Background="{DynamicResource CheckboxBackgroundBrush}"
                                    BorderBrush="{DynamicResource CheckboxBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="Mark"
                                      Data="M2,5.8 L5,8.8 L10.5,2.5"
                                      Stroke="{DynamicResource AccentButtonTextBrush}"
                                      StrokeThickness="1.7"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentButtonBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentButtonBrush}"/>
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource StartupManager_Title}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtSummary"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button x:Name="BtnRefresh"
                            Grid.Column="1"
                            Style="{StaticResource ManagerActionBtn}"
                            Content="{DynamicResource StartupManager_Refresh}"
                            Click="BtnRefresh_Click"
                            Margin="0,0,6,0"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource StartupManager_Refresh}"/>

                    <Button x:Name="BtnCloseX"
                            Grid.Column="2"
                            Style="{StaticResource ManagerCloseBtn}"
                            Click="BtnClose_Click"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource Common_Close}">
                        <Path Data="M1,1 L10,10 M10,1 L1,10"
                              Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.3"
                              Width="11"
                              Height="11"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CryoBoot Global Policy & Live Queue Strip -->
            <Border Grid.Row="1"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="12,10,12,0"
                    Padding="12,9">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{DynamicResource StartupManager_DefaultDelay}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>

                        <ComboBox x:Name="CmbDefaultDelay"
                                  Grid.Column="1"
                                  Style="{StaticResource ManagerComboBox}"
                                  Width="94"
                                  SelectionChanged="CmbDefaultDelay_SelectionChanged"
                                  AutomationProperties.Name="{DynamicResource StartupManager_DefaultDelay}"/>

                        <CheckBox x:Name="ChkWaitForIdle"
                                  Grid.Column="2"
                                  Style="{StaticResource CompactCheckBox}"
                                  Content="{DynamicResource StartupManager_WaitForIdleGlobal}"
                                  Checked="ChkWaitForIdle_Changed"
                                  Unchecked="ChkWaitForIdle_Changed"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"/>
                    </Grid>

                    <Border x:Name="BdrQueueBanner"
                            Background="{DynamicResource HighlightRowBrush}"
                            BorderBrush="{DynamicResource HighlightRowBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,7"
                            Margin="0,8,0,0"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtQueueBanner"
                                       Grid.Column="0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="11.5"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <Button x:Name="BtnLaunchAll"
                                    Grid.Column="1"
                                    Style="{StaticResource ManagerActionBtn}"
                                    Background="{DynamicResource AccentButtonBrush}"
                                    Foreground="{DynamicResource AccentButtonTextBrush}"
                                    BorderBrush="{DynamicResource AccentButtonBrush}"
                                    Content="{DynamicResource StartupManager_LaunchAll}"
                                    Click="BtnLaunchAll_Click"
                                    MinHeight="24"
                                    Padding="9,3"
                                    Margin="0,0,6,0"/>
                            <Button x:Name="BtnCancelQueue"
                                    Grid.Column="2"
                                    Style="{StaticResource ManagerActionBtn}"
                                    Content="{DynamicResource Common_Cancel}"
                                    Click="BtnCancelQueue_Click"
                                    MinHeight="24"
                                    Padding="9,3"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Search + Filter Bar -->
            <Grid Grid.Row="2" Margin="12,8,12,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <TextBox x:Name="TxtSearch"
                             Height="28"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             BorderThickness="1"
                             Padding="8,4,8,4"
                             FontSize="11.5"
                             VerticalContentAlignment="Center"
                             TextChanged="TxtSearch_TextChanged"
                             AutomationProperties.Name="{DynamicResource StartupManager_SearchPlaceholder}"/>
                    <TextBlock x:Name="TxtSearchPlaceholder"
                               Text="{DynamicResource StartupManager_SearchPlaceholder}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnFilterAll" Style="{StaticResource ManagerFilterBtn}" Tag="All" Click="FilterBtn_Click" Margin="0,0,4,0"/>
                    <Button x:Name="BtnFilterEnabled" Style="{StaticResource ManagerFilterBtn}" Tag="Enabled" Click="FilterBtn_Click" Margin="0,0,4,0"/>
                    <Button x:Name="BtnFilterDelayed" Style="{StaticResource ManagerFilterBtn}" Tag="Delayed" Click="FilterBtn_Click" Margin="0,0,4,0"/>
                    <Button x:Name="BtnFilterDisabled" Style="{StaticResource ManagerFilterBtn}" Tag="Disabled" Click="FilterBtn_Click"/>
                </StackPanel>
            </Grid>

            <!-- Startup Entry List + Loading / Empty Overlay -->
            <Grid Grid.Row="3" Margin="12,0,12,0">
                <ListBox x:Name="LstStartupItems"
                         Background="{DynamicResource InsetBackgroundBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         BorderThickness="1"
                         Padding="4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ManagerScrollBarStyle}"/>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    ToolTipService.InitialShowDelay="350">
                                <Border.ToolTip>
                                    <ToolTip Background="{DynamicResource TooltipBackgroundBrush}"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderBrush="{DynamicResource TooltipBorderBrush}"
                                             BorderThickness="1">
                                        <StackPanel MaxWidth="420">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5"/>
                                            <TextBlock Text="{Binding CommandLine}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       FlowDirection="LeftToRight"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Border.ToolTip>

                                <StackPanel>
                                    <!-- Main row -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="28" Height="28"
                                                CornerRadius="4"
                                                Background="{DynamicResource PanelAltBackgroundBrush}"
                                                BorderBrush="{DynamicResource DividerBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding Icon}"
                                                   Width="18" Height="18"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Stretch="Uniform"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ReadOnlyLabel}"
                                                       Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       FontSize="10.5"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,4,0"/>
                                            <ComboBox Style="{StaticResource ManagerComboBox}"
                                                      Width="136"
                                                      ItemsSource="{Binding ModeOptions}"
                                                      SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}"
                                                      Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}"
                                                      AutomationProperties.Name="{Binding Name}"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CryoBoot delay configuration strip (only visible while Mode == Delayed) -->
                                    <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="8,6"
                                            Margin="38,7,0,0"
                                            Visibility="{Binding IsDelayed, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Priority Order + Up/Down -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding PriorityLabel}"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           FlowDirection="LeftToRight"
                                                           Margin="0,0,4,0"/>
                                                <Button Style="{StaticResource ManagerActionBtn}"
                                                        Content="↑"
                                                        Click="BtnPriorityUp_Click"
                                                        Tag="{Binding EntryId}"
                                                        MinHeight="22"
                                                        Padding="6,1"
                                                        FontSize="10.5"
                                                        Margin="0,0,2,0"
                                                        AutomationProperties.Name="{DynamicResource StartupManager_MoveUp}"/>
                                                <Button Style="{StaticResource ManagerActionBtn}"
                                                        Content="↓"
                                                        Click="BtnPriorityDown_Click"
                                                        Tag="{Binding EntryId}"
                                                        MinHeight="22"
                                                        Padding="6,1"
                                                        FontSize="10.5"
                                                        AutomationProperties.Name="{DynamicResource StartupManager_MoveDown}"/>
                                            </StackPanel>

                                            <!-- Delay Seconds -->
                                            <ComboBox Grid.Column="1"
                                                      Style="{StaticResource ManagerComboBox}"
                                                      Width="78"
                                                      MinHeight="24"
                                                      ItemsSource="{Binding DelayOptions}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Seconds"
                                                      SelectedValue="{Binding DelaySeconds, Mode=TwoWay}"
                                                      Margin="0,0,8,0"/>

                                            <!-- Wait for Idle -->
                                            <CheckBox Grid.Column="2"
                                                      Style="{StaticResource CompactCheckBox}"
                                                      Content="{DynamicResource StartupManager_WaitForIdleItem}"
                                                      IsChecked="{Binding WaitForIdle, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,6,0"/>

                                            <!-- Live Runtime Status -->
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding RuntimeStateText}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,0,8,0"/>

                                            <!-- Launch Now -->
                                            <Button Grid.Column="4"
                                                    Style="{StaticResource ManagerActionBtn}"
                                                    Content="{DynamicResource StartupManager_LaunchNow}"
                                                    Click="BtnLaunchNow_Click"
                                                    Tag="{Binding EntryId}"
                                                    MinHeight="24"
                                                    Padding="8,2"
                                                    FontSize="10.5"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TxtListOverlayState"
                           Text="{DynamicResource StartupManager_Loading}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12.5"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"
                           IsHitTestVisible="False"/>
            </Grid>

            <!-- Inline Notice Banner -->
            <Border x:Name="BdrNotice"
                    Grid.Row="4"
                    Background="{DynamicResource DangerSoftBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="12,8,12,0"
                    Visibility="Collapsed">
                <TextBlock x:Name="TxtNotice"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="11.5"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="5"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="14,10"
                    Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{DynamicResource StartupManager_FooterHint}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button x:Name="BtnClose"
                            Grid.Column="1"
                            Style="{StaticResource ManagerActionBtn}"
                            Content="{DynamicResource Common_Close}"
                            Click="BtnClose_Click"
                            MinWidth="76"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
