<Window x:Class="CryoTray.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CryoTray"
        Width="350" Height="620"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Deactivated="Window_Deactivated"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Sleek Tooltip Style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6,3"/>
        </Style>

        <!-- Dark Pill ComboBox Style (Zero White Boxes) -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Background="#222222"
                              BorderBrush="#383838"
                              BorderThickness="1"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Arrow -->
                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="#AAAAAA"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Margin="6,0,2,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#555555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="8,0,22,0"/>

                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder"
                            Background="#1A1A1A"
                            BorderBrush="#383838"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B88D8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TimeframeComboStyle" TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- Action Button Style in Title Bar -->
        <Style x:Key="TitleActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBdr" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBdr" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Border -->
    <Border Background="#141414"
            BorderBrush="#262626"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/> <!-- Title Bar -->
                <RowDefinition Height="105"/> <!-- Hero CPU Card -->
                <RowDefinition Height="95"/> <!-- CPU Temp Chart -->
                <RowDefinition Height="Auto"/> <!-- Cooling Mode Row -->
                <RowDefinition Height="*"/> <!-- Telemetry Rows -->
            </Grid.RowDefinitions>

            <!-- 1. CUSTOM DARK TITLE BAR -->
            <Grid Grid.Row="0" Background="#141414" Margin="14,0,10,0">
                <!-- App Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAppTitle"
                               Text="CryoTray - DESKTOP-JHR1ODC"
                               Foreground="#CCCCCC"
                               FontSize="12"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Action Icons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- CPU Stress Test (Chip with pulse wave) -->
                    <Button Style="{StaticResource TitleActionBtn}" Click="BtnStressTest_Click" ToolTip="CPU Temperature Test">
                        <Path Data="M2,6 L4,6 L6,2 L8,10 L10,5 L11,7 L14,7"
                              Stroke="#AAAAAA" StrokeThickness="1.5"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Tools Menu (Sliders icon: 3 tracks with faders) -->
                    <Button x:Name="BtnToolsMenu" Style="{StaticResource TitleActionBtn}" Click="BtnToolsMenu_Click" ToolTip="Tools">
                        <Path Data="M2,3 L14,3 M5,1.5 L5,4.5 M2,8 L14,8 M10,6.5 L10,9.5 M2,13 L14,13 M6,11.5 L6,14.5"
                              Stroke="#AAAAAA" StrokeThickness="1.5"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Settings (Gear) -->
                    <Button Style="{StaticResource TitleActionBtn}" Click="BtnSettings_Click" ToolTip="Settings">
                        <Path Data="M7,2 L9,2 L9.3,3.8 A5,5 0 0,1 10.8,4.7 L12.5,3.8 L13.9,5.2 L13,6.9 A5,5 0 0,1 13.9,8.4 L15.7,8.7 L15.7,10.7 L13.9,11 A5,5 0 0,1 13,12.5 L13.9,14.2 L12.5,15.6 L10.8,14.7 A5,5 0 0,1 9.3,15.6 L9,17.4 L7,17.4 L6.7,15.6 A5,5 0 0,1 5.2,14.7 L3.5,15.6 L2.1,14.2 L3,12.5 A5,5 0 0,1 2.1,11 L0.3,10.7 L0.3,8.7 L2.1,8.4 A5,5 0 0,1 3,6.9 L2.1,5.2 L3.5,3.8 L5.2,4.7 A5,5 0 0,1 6.7,3.8 Z M8,6 A3.5,3.5 0 1,0 8,13 A3.5,3.5 0 1,0 8,6 Z"
                              Fill="#AAAAAA"
                              Width="13" Height="13" Stretch="Uniform"/>
                    </Button>

                    <!-- System Info (Monitor outline with i) -->
                    <Button Style="{StaticResource TitleActionBtn}" Click="BtnSystemInfo_Click" ToolTip="System Information">
                        <Path Data="M2,2 L14,2 A1,1 0 0,1 15,3 L15,11 A1,1 0 0,1 14,12 L10,12 L10,14 L12,14 L12,15 L4,15 L4,14 L6,14 L6,12 L2,12 A1,1 0 0,1 1,11 L1,3 A1,1 0 0,1 2,2 Z M7.5,4.5 A0.8,0.8 0 1,0 8.5,4.5 A0.8,0.8 0 1,0 7.5,4.5 Z M7.3,6.5 L8.7,6.5 L8.7,10 L7.3,10 Z"
                              Fill="#AAAAAA"
                              Width="14" Height="14" Stretch="Uniform"/>
                    </Button>

                    <!-- Close (Hide to tray) -->
                    <Button Style="{StaticResource TitleActionBtn}" Click="BtnClose_Click" ToolTip="Minimize to Tray">
                        <Path Data="M2,2 L12,12 M12,2 L2,12"
                              Stroke="#AAAAAA" StrokeThickness="1.5"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. HERO CPU HEADER CARD -->
            <Border Grid.Row="1"
                    x:Name="HeroCardBorder"
                    ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush x:Name="HeroGradient" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="GradStop1" Color="#8C4327" Offset="0.0"/>
                        <GradientStop x:Name="GradStop2" Color="#592816" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Dense Procedural Circuit Board PCB Pattern Overlay matching Camomile -->
                    <Canvas x:Name="PcbCanvas" Opacity="0.30" IsHitTestVisible="False">
                        <!-- IC Chip square with double boundary and contact pads -->
                        <Rectangle Canvas.Left="205" Canvas.Top="26" Width="48" Height="48"
                                   Stroke="#FFFFFF" StrokeThickness="1.4" Fill="Transparent"/>
                        <Rectangle Canvas.Left="212" Canvas.Top="33" Width="34" Height="34"
                                   Stroke="#FFFFFF" StrokeThickness="1" Fill="#20FFFFFF"/>

                        <!-- Via dots around chip -->
                        <Ellipse Canvas.Left="198" Canvas.Top="30" Width="3" Height="3" Fill="#FFFFFF"/>
                        <Ellipse Canvas.Left="198" Canvas.Top="45" Width="3" Height="3" Fill="#FFFFFF"/>
                        <Ellipse Canvas.Left="198" Canvas.Top="60" Width="3" Height="3" Fill="#FFFFFF"/>
                        <Ellipse Canvas.Left="257" Canvas.Top="30" Width="3" Height="3" Fill="#FFFFFF"/>
                        <Ellipse Canvas.Left="257" Canvas.Top="45" Width="3" Height="3" Fill="#FFFFFF"/>
                        <Ellipse Canvas.Left="257" Canvas.Top="60" Width="3" Height="3" Fill="#FFFFFF"/>

                        <!-- Dense circuit trace lines radiating across card -->
                        <Path Data="M0,15 L70,15 L95,40 L195,40
                                    M0,35 L40,35 L65,60 L140,60 L160,80 L205,80
                                    M0,55 L30,55 L50,75 L120,75
                                    M0,85 L80,85 L105,60 L130,60
                                    M180,5 L215,5 L215,26
                                    M230,5 L230,26
                                    M245,5 L245,26
                                    M215,74 L215,98
                                    M230,74 L230,105
                                    M245,74 L245,98 L275,98
                                    M253,35 L285,35 L305,15 L350,15
                                    M253,50 L275,50 L295,70 L350,70
                                    M253,65 L280,65 L300,85 L350,85
                                    M145,20 L165,20 L180,35
                                    M60,10 L80,10 L95,25"
                              Stroke="#FFFFFF" StrokeThickness="1.2" Fill="Transparent"/>

                        <!-- Circular Via rings with hole -->
                        <Ellipse Canvas.Left="70" Canvas.Top="13" Width="5" Height="5" Stroke="#FFFFFF" StrokeThickness="1"/>
                        <Ellipse Canvas.Left="140" Canvas.Top="58" Width="5" Height="5" Stroke="#FFFFFF" StrokeThickness="1"/>
                        <Ellipse Canvas.Left="285" Canvas.Top="33" Width="5" Height="5" Stroke="#FFFFFF" StrokeThickness="1"/>
                        <Ellipse Canvas.Left="275" Canvas.Top="48" Width="5" Height="5" Stroke="#FFFFFF" StrokeThickness="1"/>
                        <Ellipse Canvas.Left="165" Canvas.Top="18" Width="5" Height="5" Stroke="#FFFFFF" StrokeThickness="1"/>
                    </Canvas>

                    <!-- Content Layout -->
                    <Grid Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: CPU Model Header -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CPU" Foreground="#FFFFFF" FontSize="13" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtCpuModel"
                                       Text="AMD Ryzen 7 5800X"
                                       Foreground="#FFFFFF"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,3,0,0"/>
                            <TextBlock x:Name="TxtCpuCores"
                                       Text="8-Core Processor"
                                       Foreground="#E0E0E0"
                                       FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Right: Giant Thin Temperature Display with Per-Core Tooltip -->
                        <Border x:Name="CpuTempHoverZone"
                                Grid.Column="1"
                                Background="Transparent"
                                Cursor="Hand"
                                MouseEnter="CpuTempHoverZone_MouseEnter"
                                MouseLeave="CpuTempHoverZone_MouseLeave"
                                VerticalAlignment="Center">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtHeroTemp"
                                               Text="37"
                                               Foreground="#FFFFFF"
                                               FontSize="48"
                                               FontWeight="ExtraLight"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtHeroUnit"
                                               Text="°C"
                                               Foreground="#FFFFFF"
                                               FontSize="16"
                                               FontWeight="Light"
                                               VerticalAlignment="Bottom"
                                               Margin="2,0,0,10"/>
                                </StackPanel>

                                <!-- Per-Core Speech-Bubble Popup on Hover -->
                                <Popup x:Name="CpuCoresPopup"
                                       AllowsTransparency="True"
                                       Placement="Top"
                                       PlacementTarget="{Binding ElementName=CpuTempHoverZone}"
                                       VerticalOffset="6"
                                       HorizontalOffset="-230"
                                       PopupAnimation="Fade"
                                       IsHitTestVisible="False">
                                    <Grid Margin="6" IsHitTestVisible="False">
                                        <Grid.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
                                        </Grid.Effect>
                                        <StackPanel HorizontalAlignment="Right">
                                            <!-- White Speech Bubble Box -->
                                            <Border Background="#FFFFFF"
                                                    BorderBrush="#CCCCCC"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    SnapsToDevicePixels="True">
                                                <UniformGrid x:Name="CoreTempsGrid" Columns="4" Rows="2">
                                                    <!-- Dynamic per-core cells -->
                                                </UniformGrid>
                                            </Border>

                                            <!-- Downward Triangle Caret pointing directly down over digits -->
                                            <Canvas Height="6" Width="14" Margin="0,-1,42,0" HorizontalAlignment="Right">
                                                <Polygon Points="0,0 7,6 14,0" Fill="#FFFFFF" Stroke="#CCCCCC" StrokeThickness="1"/>
                                                <Line X1="1" Y1="0" X2="13" Y2="0" Stroke="#FFFFFF" StrokeThickness="1.5"/>
                                            </Canvas>
                                        </StackPanel>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 3. LIVE CPU TEMPERATURE CHART & TIMEFRAME SELECTOR -->
            <Grid Grid.Row="2" Background="#121212">
                <!-- Chart Canvas with subtle grid lines -->
                <Canvas x:Name="CpuChartCanvas" ClipToBounds="True" SizeChanged="CpuChartCanvas_SizeChanged"/>

                <!-- Centered Timeframe Dropdown Pill overlapping bottom axis -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,4">
                    <ComboBox x:Name="CmbTimeframe"
                              Style="{StaticResource TimeframeComboStyle}"
                              SelectionChanged="CmbTimeframe_SelectionChanged">
                        <ComboBoxItem Content="1 min" IsSelected="True"/>
                        <ComboBoxItem Content="5 min"/>
                        <ComboBoxItem Content="10 min"/>
                        <ComboBoxItem Content="30 min"/>
                        <ComboBoxItem Content="60 min"/>
                    </ComboBox>
                </Border>
            </Grid>

            <!-- 4. COOLING MODE CONTROL ROW -->
            <Border Grid.Row="3" Background="#141414" Padding="14,14" BorderBrush="#262626" BorderThickness="0,1,0,1">
                <Grid>
                    <!-- Left: Fan Icon + Label -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Multi-blade PC Fan matching Camomile -->
                        <Grid Width="30" Height="30" Margin="0,0,10,0">
                            <!-- Outer Cyan/Blue Rim -->
                            <Ellipse Width="30" Height="30" Stroke="#2B88D8" StrokeThickness="1.5" Fill="#161616"/>
                            <Ellipse x:Name="FanGlowCircle" Width="30" Height="30" Fill="#2B88D8" Opacity="0.15"/>

                            <!-- Rotating Fan Blades -->
                            <Canvas x:Name="FanCanvas" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="FanRotation" Angle="0"/>
                                </Canvas.RenderTransform>

                                <!-- 7 Curved PC Fan Blades -->
                                <Path Data="M13,13 C13,9 14.5,4 17,3 C17.5,5 16,9 13,13 Z
                                            M13,13 C16,10.5 21,9 22.5,11 C21.5,13 17,14 13,13 Z
                                            M13,13 C16,14.5 19,18.5 18,20.5 C16.5,20 14,16 13,13 Z
                                            M13,13 C12.5,16.5 11,21 9,21 C8,19.5 10.5,15.5 13,13 Z
                                            M13,13 C10,15 5.5,16 4,14 C5,12 9.5,12 13,13 Z
                                            M13,13 C10.5,11 7,7.5 8,6 C9.5,6.5 11.5,10 13,13 Z"
                                      Fill="#76C6EF"
                                      x:Name="FanBladePath"/>

                                <!-- Center Golden Hub Ring with dark core -->
                                <Ellipse Canvas.Left="10" Canvas.Top="10" Width="6" Height="6" Fill="#D4A045"/>
                                <Ellipse Canvas.Left="11.5" Canvas.Top="11.5" Width="3" Height="3" Fill="#111111"/>
                            </Canvas>
                        </Grid>

                        <TextBlock Text="Cooling Mode" Foreground="#FFFFFF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text=" ⓘ" Foreground="#666666" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Activates CryoTray Cooling low-heat power plan"/>
                    </StackPanel>

                    <!-- Right: Smooth Animated Pill Toggle Switch matching Camomile -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="ToggleSwitch_Click">
                        <Border x:Name="TogglePillBorder"
                                Width="52" Height="26"
                                CornerRadius="13"
                                Background="#E07D62"
                                Padding="2">
                            <Grid>
                                <!-- Text (OFF or ON) -->
                                <TextBlock x:Name="TxtToggleState"
                                           Text="OFF"
                                           Foreground="#FFFFFF"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="0,0,7,0"/>

                                <!-- White Thumb Knob -->
                                <Ellipse x:Name="ToggleThumb"
                                         Width="22" Height="22"
                                         Fill="#FFFFFF"
                                         HorizontalAlignment="Left"
                                         Margin="1,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <!-- 5. HARDWARE TELEMETRY ROWS -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14,6,14,14">

                    <!-- ROW 1: CPU SPEED -->
                    <Grid Height="44">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#1D1D1D" CornerRadius="4" BorderBrush="#2C2C2C" BorderThickness="1" Margin="0,0,10,0">
                                <!-- Chip with 3 horizontal wavy clock signals -->
                                <Path Data="M3,5 L5,5 L5,3 M11,3 L11,5 L13,5 M13,11 L11,11 L11,13 M5,13 L5,11 L3,11
                                            M5,6.5 C6,5.5 7,7.5 8,6.5 C9,5.5 10,7.5 11,6.5
                                            M5,8.5 C6,7.5 7,9.5 8,8.5 C9,7.5 10,9.5 11,8.5
                                            M5,10.5 C6,9.5 7,11.5 8,10.5 C9,9.5 10,11.5 11,10.5"
                                      Stroke="#AAAAAA" StrokeThickness="1.2" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="CPU SPEED" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#1D1D1D" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtCpuClockRatio" Text="3.66 / 3.80" Foreground="#DDDDDD" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#1D1D1D" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="GHZ" Foreground="#888888" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="#202020" Margin="0,2"/>

                    <!-- ROW 2: GPU (Nvidia / AMD / Intel) -->
                    <Grid Height="48">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#1D1D1D" CornerRadius="4" BorderBrush="#2C2C2C" BorderThickness="1" Margin="0,0,10,0">
                                <!-- Graphics Card icon with dual fans -->
                                <Path Data="M2,4 L14,4 L14,12 L2,12 Z M4,12 L12,12 L12,13.5 L4,13.5 Z M5.5,8 A1.5,1.5 0 1,0 8.5,8 A1.5,1.5 0 1,0 5.5,8 Z M9.5,8 A1.5,1.5 0 1,0 12.5,8 A1.5,1.5 0 1,0 9.5,8 Z"
                                      Stroke="#AAAAAA" StrokeThickness="1" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="TxtGpuLabel" Text="GPU (Nvidia)" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right" Width="140" Height="28" Background="#121212" BorderBrush="#242424" BorderThickness="1" CornerRadius="3" VerticalAlignment="Center">
                            <Canvas x:Name="GpuChartCanvas" ClipToBounds="True" ToolTip="GPU Temperature &amp; Load"/>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="#202020" Margin="0,2"/>

                    <!-- DYNAMIC SSD ROWS CONTAINER -->
                    <StackPanel x:Name="SsdRowsContainer">
                    </StackPanel>

                    <!-- ROW: OVERLAY (Unlocked Feature) -->
                    <Grid Height="44">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="26" Height="26" Background="#1D1D1D" CornerRadius="4" BorderBrush="#2C2C2C" BorderThickness="1" Margin="0,0,10,0">
                                <!-- Chip with pulse/heartbeat line -->
                                <Path Data="M2,8 L5,8 L7,3 L9,13 L11,7 L14,8"
                                      Stroke="#AAAAAA" StrokeThickness="1.4" Stretch="Uniform" Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="OVERLAY" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Button Click="BtnOverlay_Click"
                                Content="Manage"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Foreground="#2B88D8"
                                FontWeight="SemiBold"
                                FontSize="12"
                                BorderThickness="0"
