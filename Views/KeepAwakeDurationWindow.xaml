<Window x:Class="CryoTray.Views.KeepAwakeDurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource KeepAwake_CustomTitle}"
        Width="390"
        SizeToContent="Height"
        MinHeight="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Images/CryoTray.ico"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ActiveBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource AccentPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            SnapsToDevicePixels="True">
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource KeepAwake_CustomTitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource KeepAwake_CustomBody}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12.5"
                       TextWrapping="Wrap"
                       Margin="0,8,0,14"/>

            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="130"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource KeepAwake_DurationLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5"
                               Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtDuration"
                             Text="45"
                             Height="32"
                             Padding="8,4"
                             Background="{DynamicResource InputBackgroundBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="13"
                             MaxLength="6"
                             FlowDirection="LeftToRight"
                             AutomationProperties.Name="{DynamicResource KeepAwake_DurationLabel}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource KeepAwake_UnitLabel}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5"
                               Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbUnit"
                              Height="32"
                              SelectedIndex="0"
                              AutomationProperties.Name="{DynamicResource KeepAwake_UnitLabel}">
                        <ComboBoxItem Content="{DynamicResource KeepAwake_Minutes}" Tag="Minutes"/>
                        <ComboBoxItem Content="{DynamicResource KeepAwake_Hours}" Tag="Hours"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="3"
                       x:Name="TxtRangeHint"
                       Text="{DynamicResource KeepAwake_CustomRange}"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <TextBlock Grid.Row="4"
                       x:Name="TxtError"
                       Foreground="{DynamicResource WarningTextBrush}"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"/>

            <StackPanel Grid.Row="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,8,0,0">
                <Button Content="{DynamicResource Common_Cancel}"
                        Style="{StaticResource DialogButton}"
                        Click="BtnCancel_Click"
                        IsCancel="True"
                        MinWidth="82"
                        Height="34"
                        Margin="0,0,10,0"/>
                <Button Content="{DynamicResource KeepAwake_StartButton}"
                        Style="{StaticResource DialogPrimaryButton}"
                        Click="BtnStart_Click"
                        IsDefault="True"
                        MinWidth="88"
                        Height="34"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
