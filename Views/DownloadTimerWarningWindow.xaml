<Window x:Class="CryoTray.Views.DownloadTimerWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource DownloadTimer_WarningTitle}"
        Width="430" Height="186"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="Window_Closing">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource WarningTextBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Padding="20,16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource DownloadTimer_WarningTitle}"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="TxtWarningBody"
                       Grid.Row="1"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0,9,0,14"/>

            <Button x:Name="BtnCancel"
                    Grid.Row="2"
                    Content="{DynamicResource DownloadTimer_Cancel}"
                    Click="BtnCancel_Click"
                    HorizontalAlignment="Left"
                    MinWidth="132"
                    Height="44"
                    Padding="18,0"
                    Background="{DynamicResource DangerSoftBackgroundBrush}"
                    Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource DangerTextBrush}"
                    BorderThickness="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DangerSoftHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
