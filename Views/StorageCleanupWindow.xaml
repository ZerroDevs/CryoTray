<Window x:Class="CryoTray.Views.StorageCleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource StorageCleanup_Title}"
        Width="392"
        Height="660"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Images/CryoTray.ico"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="CleanupMetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="CleanupMetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="CleanupMetricDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>

        <Style x:Key="CleanupCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="{StaticResource SegoeUIVariableText}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid x:Name="CheckRoot" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CheckBorder"
                                    Width="16"
                                    Height="16"
                                    Margin="0,2,8,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource CheckboxBackgroundBrush}"
                                    BorderBrush="{DynamicResource CheckboxBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                <Path x:Name="CheckMark"
                                      Data="M2,6 L5.5,9.5 L12,2.5"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CheckRoot" Property="Opacity" Value="0.55"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanupSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource MenuHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ActiveBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanupPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource ActiveBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanupCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CloseBorder" Property="BorderBrush" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanupScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Margin" Value="0,4,2,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb MinHeight="24" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        Width="5"
                                                        Background="{DynamicResource TextMutedBrush}"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource TextTertiaryBrush}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False"
                                                  Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CleanupFolderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleSurface" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path x:Name="Chevron"
                                      Data="M1,0 L5,4 L1,8"
                                      Stroke="{DynamicResource TextTertiaryBrush}"
                                      StrokeThickness="1.3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Width="6"
                                      Height="8"
                                      Margin="0,1,5,0"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="90"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ToggleSurface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CleanupCategoryTemplate">
            <Border BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="11,7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Row="0"
                              Grid.Column="0"
                              Style="{StaticResource CleanupCheckBox}"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              IsEnabled="{Binding IsSelectionEnabled}"
                              AutomationProperties.Name="{Binding Title}"
                              AutomationProperties.HelpText="{Binding Description}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6"
                                     Height="6"
                                     Fill="{Binding DotBrush}"
                                     Opacity="{Binding DotOpacity}"
                                     Margin="0,6,6,0"
                                     VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Title}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"
                                       LineHeight="16"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Top"/>
                            <Border Grid.Column="2"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="4,0"
                                    Margin="6,1,0,0"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding Badge}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </CheckBox>

                    <StackPanel Grid.Row="0"
                                Grid.Column="1"
                                MinWidth="76"
                                Margin="8,1,0,0">
                        <TextBlock Text="{Binding SizeText}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right"
                                   FlowDirection="LeftToRight"/>
                        <TextBlock Text="{Binding FilesText}"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="9.5"
                                   TextAlignment="Right"
                                   HorizontalAlignment="Right"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Grid.ColumnSpan="2"
                               Text="{Binding Description}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10.5"
                               LineHeight="13.5"
                               TextWrapping="Wrap"
                               Margin="22,3,0,0"/>

                    <StackPanel Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="22,3,0,0"
                                Visibility="{Binding FoldersToggleVisibility}">
                        <ToggleButton Style="{StaticResource CleanupFolderToggleStyle}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding FoldersToggleText}">
                            <TextBlock Text="{Binding FoldersToggleText}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </ToggleButton>
                        <ItemsControl ItemsSource="{Binding TargetRows}"
                                      Visibility="{Binding FoldersListVisibility}"
                                      Margin="11,2,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1.5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayPath}"
                                                   ToolTip="{Binding FullPath}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="9.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   FlowDirection="LeftToRight"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SummaryText}"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   FontSize="9.5"
                                                   Margin="8,0,0,0"
                                                   FlowDirection="LeftToRight"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,10,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{DynamicResource StorageCleanup_Title}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource CleanupCloseButton}"
                            Click="BtnClose_Click"
                            AutomationProperties.Name="{DynamicResource StorageCleanup_CloseAutomation}">
                        <Path Data="M1,1 L10,10 M10,1 L1,10"
                              Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.3"
                              Width="11"
                              Height="11"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="12,10,12,0"
                        Padding="12,9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{DynamicResource StorageCleanup_Selected}"
                                       Style="{StaticResource CleanupMetricLabel}"/>
                            <TextBlock x:Name="TxtSelectedValue"
                                       Text="--"
                                       Style="{StaticResource CleanupMetricValue}"
                                       Foreground="{DynamicResource RamAccentBrush}"/>
                            <TextBlock x:Name="TxtSelectedDetail"
                                       Text="{DynamicResource StorageCleanup_Scanning}"
                                       Style="{StaticResource CleanupMetricDetail}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Text="{DynamicResource StorageCleanup_FilesFound}"
                                       Style="{StaticResource CleanupMetricLabel}"/>
                            <TextBlock x:Name="TxtFilesFound"
                                       Text="--"
                                       Style="{StaticResource CleanupMetricValue}"/>
                            <TextBlock x:Name="TxtFilesDetail"
                                       Text="{DynamicResource StorageCleanup_Scanning}"
                                       Style="{StaticResource CleanupMetricDetail}"/>
                        </StackPanel>

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource StorageCleanup_Distribution}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotal"
                                       Grid.Column="1"
                                       Text="--"
                                       Foreground="{DynamicResource RamAccentBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>

                        <Grid x:Name="CategoryChartHost"
                              Grid.Row="2"
                              Grid.ColumnSpan="2"
                              Height="10"
                              Background="{DynamicResource DividerBrush}"
                              ClipToBounds="True"
                              Margin="0,5,0,0">
                            <Grid x:Name="CategoryChartBars"/>
                            <TextBlock x:Name="TxtChartState"
                                       Text="{DynamicResource StorageCleanup_Scanning}"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Row="3"
                                    Grid.ColumnSpan="2"
                                    Margin="0,7,0,0">
                            <TextBlock x:Name="TxtPhase"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="9.5"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <ProgressBar x:Name="ScanProgress"
                                         Height="3"
                                         Margin="0,4,0,0"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed"
                                         Foreground="{DynamicResource RamAccentBrush}"
                                         Background="{DynamicResource DividerBrush}"
                                         BorderThickness="0"
                                         AutomationProperties.Name="{DynamicResource StorageCleanup_Scanning}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="DriveCard"
                        Grid.Row="1"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="12,7,12,0"
                        Padding="10,6"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtDriveLabel"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDriveFree"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="9.5"
                                   Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   FlowDirection="LeftToRight"/>
                        <Grid x:Name="DriveUsageBar"
                              Grid.Row="1"
                              Grid.ColumnSpan="2"
                              Height="5"
                              Background="{DynamicResource DividerBrush}"
                              ClipToBounds="True"
                              Margin="0,5,0,0"/>
                    </Grid>
                </Border>

                <Border x:Name="TempAgeOptionBar"
                        Grid.Row="2"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="12,7,12,0"
                        Padding="10,5">
                    <CheckBox x:Name="ChkSkipRecentTemp"
                              Style="{StaticResource CleanupCheckBox}"
                              IsChecked="True"
                              Checked="ChkSkipRecentTemp_Changed"
                              Unchecked="ChkSkipRecentTemp_Changed"
                              ToolTip="{DynamicResource StorageCleanup_SkipRecentTempTooltip}"
                              AutomationProperties.Name="{DynamicResource StorageCleanup_SkipRecentTemp}">
                        <TextBlock Text="{DynamicResource StorageCleanup_SkipRecentTemp}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </CheckBox>
                </Border>

                <Border Grid.Row="3"
                        Background="{DynamicResource PanelBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Margin="12,7,12,0"
                        SnapsToDevicePixels="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Resources>
                            <Style TargetType="ScrollBar" BasedOn="{StaticResource CleanupScrollBarStyle}"/>
                        </ScrollViewer.Resources>
                        <ItemsControl x:Name="CategoriesItems"
                                      ItemTemplate="{StaticResource CleanupCategoryTemplate}"/>
                    </ScrollViewer>
                </Border>

                <Border x:Name="BrowserHint"
                        Grid.Row="4"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="9,6"
                        Margin="12,7,12,0"
                        Visibility="Collapsed">
                    <TextBlock Text="{DynamicResource StorageCleanup_BrowserHint}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="10"
                               LineHeight="13"
                               TextWrapping="Wrap"/>
                </Border>

                <Border x:Name="ConfirmBanner"
                        Grid.Row="5"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentTextBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="9,7"
                        Margin="12,7,12,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtConfirm"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="10.5"
                                   LineHeight="13.5"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Assertive"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                            <Button x:Name="BtnConfirmBack"
                                    Content="{DynamicResource StorageCleanup_ConfirmBack}"
                                    Style="{StaticResource CleanupSecondaryButton}"
                                    MinWidth="66"
                                    Margin="0,0,7,0"
                                    Click="BtnConfirmBack_Click"/>
                            <Button x:Name="BtnConfirmClean"
                                    Content="{DynamicResource StorageCleanup_ConfirmClean}"
                                    Style="{StaticResource CleanupPrimaryButton}"
                                    MinWidth="84"
                                    Click="BtnConfirmClean_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="ResultBanner"
                        Grid.Row="6"
                        Background="{DynamicResource PanelAltBackgroundBrush}"
                        BorderBrush="{DynamicResource SuccessTextBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="9,6"
                        Margin="12,7,12,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="TxtResult"
                                   Foreground="{DynamicResource SuccessTextBrush}"
                                   FontSize="10.5"
                                   LineHeight="13"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Button x:Name="BtnResultRescan"
                                Content="{DynamicResource StorageCleanup_Rescan}"
                                Style="{StaticResource CleanupSecondaryButton}"
                                HorizontalAlignment="Right"
                                MinWidth="70"
                                Margin="0,6,0,0"
                                Visibility="Collapsed"
                                Click="BtnResultRescan_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="12,9"
                    Margin="0,9,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnRescan"
                            Content="{DynamicResource StorageCleanup_Rescan}"
                            Style="{StaticResource CleanupSecondaryButton}"
                            MinWidth="70"
                            Margin="0,0,7,0"
                            Click="BtnRescan_Click"/>
                    <Button x:Name="BtnCancel"
                            Content="{DynamicResource StorageCleanup_Close}"
                            Style="{StaticResource CleanupSecondaryButton}"
                            MinWidth="60"
                            Margin="0,0,7,0"
                            Click="BtnCancel_Click"/>
                    <Button x:Name="BtnClean"
                            Content="{DynamicResource StorageCleanup_CleanSelected}"
                            Style="{StaticResource CleanupPrimaryButton}"
                            MinWidth="96"
                            IsDefault="False"
                            Click="BtnClean_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
