<Window x:Class="CryoTray.Views.StressTestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Stress_Title}"
        Height="478" Width="480"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#141414"
        Icon="pack://application:,,,/Images/CryoTray.ico"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="0"
        ResizeMode="NoResize"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#141414"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Path x:Name="StressHeaderIcon" Data="M4,2 L12,2 L12,4 L14,4 L14,12 L12,12 L12,14 L4,14 L4,12 L2,12 L2,4 L4,4 Z M6,6 L10,6 L10,10 L6,10 Z"
                      Fill="{DynamicResource WindowBorderBrush}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource Stress_Header}" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="5" AutomationProperties.Name="{DynamicResource Stress_CloseAutomation}">
                <Path Data="M1,1 L10,10 M10,1 L1,10" Stroke="#B0B0B0" StrokeThickness="1.3" Width="11" Height="11" Stretch="Uniform"/>
            </Button>
        </Grid>

        <!-- Stats Bar -->
        <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="0" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Stress_CpuTemp}" Foreground="#888888" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTestTemp" Text="-- °C" Foreground="#4FC3F7" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Stress_CpuSpeed}" Foreground="#888888" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtTestSpeed" Text="-- GHz" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Stress_Elapsed}" Foreground="#888888" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtElapsed" Text="00:00" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" FlowDirection="LeftToRight"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cooling OFF vs ON Delta Bar -->
        <Border x:Name="DeltaSummaryBorder" Grid.Row="2" Background="#1A1A1A" BorderBrush="#333333" BorderThickness="1" CornerRadius="0" Padding="14,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Stress_PhaseOff}" Foreground="#E5987E" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPhaseOff" Text="--" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource Stress_PhaseOn}" Foreground="#76C6ED" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPhaseOn" Text="--" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" FlowDirection="LeftToRight" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Stress_PhaseDelta}" Foreground="#ABD068" FontSize="10" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtPhaseDelta" Text="{DynamicResource Stress_DeltaHint}" Foreground="#B0B0B0" FontSize="12.5" FontWeight="Bold" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Chart Canvas -->
        <Border Grid.Row="3" Background="#121212" CornerRadius="0" BorderBrush="#383838" BorderThickness="1" Margin="0,0,0,14">
            <Canvas x:Name="ChartCanvas" FlowDirection="LeftToRight" ClipToBounds="True"/>
        </Border>

        <!-- Cooling Switch inside test -->
        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.Resources>
                <Style x:Key="StressActionBtnStyle" TargetType="Button">
                    <Setter Property="Background" Value="#242424"/>
                    <Setter Property="Foreground" Value="#D8D8D8"/>
                    <Setter Property="BorderBrush" Value="#3B3B3B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="12,6"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#2E2E2E"/>
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#555555"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource WindowBorderBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="BtnBorder" Property="Background" Value="#1B1B1B"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.42"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Stress_CoolingMode}" Foreground="#CCCCCC" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtCoolingStatus" Text="{DynamicResource Common_Off}" Foreground="#E5987E" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnExportCsv"
                        Click="BtnExportCsv_Click"
                        Content="{DynamicResource Stress_ExportCsv}"
                        IsEnabled="False"
                        Style="{StaticResource StressActionBtnStyle}"
                        Margin="0,0,8,0"/>
                <Button x:Name="BtnToggleCooling"
                        Click="BtnToggleCooling_Click"
                        Content="{DynamicResource Stress_ToggleCooling}"
                        Style="{StaticResource StressActionBtnStyle}"/>
            </StackPanel>
        </Grid>

        <!-- Start / Stop Button -->
        <Button Grid.Row="5"
                x:Name="BtnStartStop"
                Click="BtnStartStop_Click"
                Content="{DynamicResource Stress_Start}"
                Height="40"
                Background="#2B88D8"
                Foreground="#FFFFFF"
                FontWeight="SemiBold"
                FontSize="14"
                BorderThickness="0"
                Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="2"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
    </Border>
</Window>
