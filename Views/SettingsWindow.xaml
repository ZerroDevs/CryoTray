<Window x:Class="CryoTray.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Height="620" Width="480"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#181818"
        BorderBrush="#2C2C2C"
        BorderThickness="1"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <!-- Custom Dark CheckBox Style -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder"
                                    Width="18" Height="18"
                                    Background="#202020"
                                    BorderBrush="#444444"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M2,7 L6,11 L14,3"
                                      Stroke="#2B88D8"
                                      StrokeThickness="2"
                                      Visibility="Collapsed"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#252525"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#2B88D8"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Template (Zero White Boxes) -->
        <ControlTemplate x:Key="SettingsDarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <ToggleButton x:Name="ToggleButton"
                              Background="#202020"
                              BorderBrush="#383838"
                              BorderThickness="1"
                              Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                              ClickMode="Press">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="10,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="#AAAAAA"
                                          StrokeThickness="1.5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"
                                          Margin="8,0,2,0"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Border" Property="Background" Value="#282828"/>
                                    <Setter TargetName="Border" Property="BorderBrush" Value="#555555"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <ContentPresenter x:Name="ContentSite"
                                  IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Left"
                                  Margin="12,0,28,0"/>

                <Popup x:Name="Popup"
                       Placement="Bottom"
                       IsOpen="{TemplateBinding IsDropDownOpen}"
                       AllowsTransparency="True"
                       Focusable="False"
                       PopupAnimation="Slide">
                    <Border x:Name="DropDownBorder"
                            Background="#1A1A1A"
                            BorderBrush="#383838"
                            BorderThickness="1"
                            CornerRadius="4"
                            MinWidth="{TemplateBinding ActualWidth}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}">
                        <ScrollViewer SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDDDDD"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2B88D8"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E5C91"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Template" Value="{StaticResource SettingsDarkComboBoxTemplate}"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="34"/>
        </Style>

        <!-- Custom Tab Button Style -->
        <Style x:Key="TabButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,2"
                                BorderBrush="Transparent"
                                Padding="8,8,8,6">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#2B88D8"/>
                                <Setter Property="Foreground" Value="#2B88D8"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#CCCCCC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Settings" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
            <Button HorizontalAlignment="Right" Click="BtnClose_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="4">
                <TextBlock Text="✕" Foreground="#888888" FontSize="14"/>
            </Button>
        </Grid>

        <!-- Tab Bar -->
        <Border Grid.Row="1" BorderBrush="#252525" BorderThickness="0,0,0,1" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabGeneral" Style="{StaticResource TabButtonStyle}" Content="General" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabView" Style="{StaticResource TabButtonStyle}" Content="View" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabCpu" Style="{StaticResource TabButtonStyle}" Content="CPU" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDisk" Style="{StaticResource TabButtonStyle}" Content="Disk" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabGpu" Style="{StaticResource TabButtonStyle}" Content="GPU" Checked="Tab_Checked"/>
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
            <StackPanel>
                <!-- GENERAL TAB -->
                <StackPanel x:Name="PanelGeneral">
                    <!-- Language -->
                    <TextBlock Text="Language" Foreground="#888888" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbLanguage" Margin="0,0,0,14" SelectionChanged="CmbLanguage_SelectionChanged">
                        <ComboBoxItem Content="English" IsSelected="True"/>
                        <ComboBoxItem Content="العربية"/>
                    </ComboBox>

                    <!-- Temperature Units -->
                    <TextBlock Text="Temperature units" Foreground="#888888" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbTempUnits" Margin="0,0,0,16" SelectionChanged="CmbTempUnits_SelectionChanged">
                        <ComboBoxItem Content="Celsius (°C)" IsSelected="True"/>
                        <ComboBoxItem Content="Fahrenheit (°F)"/>
                    </ComboBox>

                    <!-- Checkboxes -->
                    <CheckBox x:Name="ChkShowComputerName" Content="Show computer name" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkLaunchStartup" Content="Launch app on PC startup" Checked="ChkLaunchStartup_Changed" Unchecked="ChkLaunchStartup_Changed"/>
                    <CheckBox x:Name="ChkLaunchBackground" Content="Launch app in background mode" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkEnableCoolingOnLaunch" Content="Enable Cooling Mode on app launch" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkPinToTaskbar" Content="Pin window to taskbar" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkAlwaysOnTop" Content="Always on top" Checked="SettingChanged" Unchecked="SettingChanged"/>

                    <!-- Hotkey combo -->
                    <CheckBox x:Name="ChkUseHotkey" Content="Use a key combo to enable/disable Cooling Mode" Checked="ChkUseHotkey_Changed" Unchecked="ChkUseHotkey_Changed" Margin="0,8,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="28,2,0,0">
                        <TextBlock Text="Ctrl + Shift + " Foreground="#888888" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtHotkeyKey"
                                 Text="C"
                                 Width="48" Height="28"
                                 Background="#202020"
                                 Foreground="#FFFFFF"
                                 BorderBrush="#383838"
                                 BorderThickness="1"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center"
                                 KeyDown="TxtHotkeyKey_KeyDown"
                                 Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- VIEW TAB -->
                <StackPanel x:Name="PanelView" Visibility="Collapsed">
                    <TextBlock Text="System Tray Badges" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ChkShowGpuBadge" Content="Show GPU badge in system tray (Green)" Checked="SettingChanged" Unchecked="SettingChanged"/>
                    <CheckBox x:Name="ChkShowCpuBadge" Content="Show CPU badge in system tray (Coral / Cyan)" Checked="SettingChanged" Unchecked="SettingChanged"/>

                    <TextBlock Text="Window Docking" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,16,0,10"/>
                    <CheckBox x:Name="ChkAnchorToTray" Content="Anchor dashboard window above taskbar notification area" Checked="SettingChanged" Unchecked="SettingChanged"/>
                </StackPanel>

                <!-- CPU TAB -->
                <StackPanel x:Name="PanelCpu" Visibility="Collapsed">
                    <TextBlock Text="CryoTray Cooling Controls" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                    <TextBlock Text="Adjusts hardware cooling parameters in the CryoTray Cooling power plan." Foreground="#888888" FontSize="11" Margin="0,0,0,14"/>

                    <!-- Processor Performance Boost Mode (PERFBOOSTMODE) -->
                    <TextBlock Text="Processor Performance Boost Mode (PERFBOOSTMODE)" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbPerfBoostMode" Margin="0,0,0,16" SelectionChanged="CmbPerfBoostMode_SelectionChanged">
                        <ComboBoxItem Content="Disabled (Recommended - Low Heat)" IsSelected="True"/>
                        <ComboBoxItem Content="Enabled (Aggressive Boost)"/>
                    </ComboBox>

                    <!-- Maximum Processor State (PROCTHROTTLEMAX) -->
                    <TextBlock Text="Maximum Processor State (PROCTHROTTLEMAX)" Foreground="#CCCCCC" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldThrottle" Minimum="50" Maximum="100" Value="99" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="SldThrottle_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="TxtThrottleVal" Text="99%" Foreground="#2B88D8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#262626" Margin="0,4,0,14"/>

                    <!-- Autopilot Rules -->
                    <TextBlock Text="Autopilot Rules" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <CheckBox x:Name="ChkAutopilot" Content="Enable Autopilot intelligent cooling" Checked="SettingChanged" Unchecked="SettingChanged"/>

                    <TextBlock Text="Idle Load Threshold % (Turn ON Cooling)" Foreground="#888888" FontSize="12" Margin="0,6,0,4"/>
                    <Slider x:Name="SldIdleThreshold" Minimum="10" Maximum="50" Value="25" ValueChanged="SettingChanged"/>

                    <TextBlock Text="High Load Threshold % (Turn OFF Cooling for Speed)" Foreground="#888888" FontSize="12" Margin="0,6,0,4"/>
                    <Slider x:Name="SldBusyThreshold" Minimum="50" Maximum="90" Value="65" ValueChanged="SettingChanged"/>
                </StackPanel>

                <!-- DISK TAB -->
                <StackPanel x:Name="PanelDisk" Visibility="Collapsed">
                    <TextBlock Text="Storage Drive Preferences" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="High Temperature Alert Threshold" Foreground="#888888" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldDiskThreshold" Minimum="40" Maximum="85" Value="60" ValueChanged="SldDiskThreshold_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="TxtDiskThreshold" Text="60°C" Foreground="#2B88D8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- GPU TAB -->
                <StackPanel x:Name="PanelGpu" Visibility="Collapsed">
                    <TextBlock Text="GPU Preferences" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="High Temperature Alert Threshold" Foreground="#888888" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="SldGpuThreshold" Minimum="50" Maximum="95" Value="80" ValueChanged="SldGpuThreshold_ValueChanged"/>
                        <TextBlock Grid.Column="1" x:Name="TxtGpuThreshold" Text="80°C" Foreground="#7CB342" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnExport" Click="BtnExport_Click" Content="↑ Export" Background="#2C2C2C" Foreground="#CCCCCC" BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="BtnImport" Click="BtnImport_Click" Content="↓ Import" Background="#2C2C2C" Foreground="#CCCCCC" BorderThickness="0" Padding="14,8" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <Button x:Name="BtnReset" Click="BtnReset_Click" Content="↺ Reset" HorizontalAlignment="Right" Background="#2C2C2C" Foreground="#CCCCCC" BorderThickness="0" Padding="14,8" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="4"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>
