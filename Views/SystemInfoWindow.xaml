<Window x:Class="CryoTray.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Information"
        Height="620" Width="430"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#181818"
        BorderBrush="#2C2C2C"
        BorderThickness="1"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="System information"
                       Foreground="#FFFFFF"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnSaveTo"
                        Click="BtnSaveTo_Click"
                        Background="Transparent"
                        BorderBrush="#2B88D8"
                        BorderThickness="1"
                        Foreground="#2B88D8"
                        Cursor="Hand"
                        Padding="10,4"
                        Margin="0,0,14,0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M3,3 L11,3 L13,5 L13,13 L3,13 Z M5,5 L5,7 L11,7 L11,5 Z M5,9 L11,9 L11,11 L5,11 Z"
                              Fill="#2B88D8" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0"/>
                        <TextBlock Text="Save to.." FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <Button Click="BtnClose_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="4">
                    <TextBlock Text="✕" Foreground="#888888" FontSize="14"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scrollable Key-Value List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InfoContainer">
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
