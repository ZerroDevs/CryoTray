<Window x:Class="CryoTray.Views.SystemInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource System_Title}"
        Height="660" Width="434"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#141414"
        BorderBrush="{DynamicResource WindowBorderBrush}"
        BorderThickness="0"
        ResizeMode="NoResize"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="#141414"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0"
                Background="#1B1B1B"
                BorderBrush="#333333"
                BorderThickness="0,0,0,1"
                Padding="24,12">
            <Grid>
                <TextBlock Text="{DynamicResource System_Header}"
                           Foreground="#FFFFFF"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnSaveTo"
                            Click="BtnSaveTo_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#2B88D8"
                            Cursor="Hand"
                            Padding="4"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M4,2 L11,2 L14,5 L14,14 L2,14 L2,2 Z M5,2 L5,6 L11,6 L11,2 M5,9 L11,9 L11,13 L5,13 Z"
                                  Stroke="#2B88D8"
                                  StrokeThickness="1.15"
                                  Width="13" Height="13"
                                  Stretch="Uniform"
                                  Margin="0,0,6,0"
                                  VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource System_SaveTo}" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="BtnClose_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Padding="5"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource System_CloseAutomation}">
                        <Path Data="M1,1 L10,10 M10,1 L1,10"
                              Stroke="#B0B0B0"
                              StrokeThickness="1.3"
                              Width="11" Height="11"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Key-Value List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="InfoContainer" Margin="12,8,12,8">
            </StackPanel>
        </ScrollViewer>
    </Grid>
    </Border>
</Window>
