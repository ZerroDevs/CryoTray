<Window x:Class="CryoTray.Views.SessionReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Session_Title}"
        Width="560" Height="660"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="pack://application:,,,/Images/CryoTray.ico"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        FontFamily="{StaticResource SegoeUIVariableText}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        AutomationProperties.Name="{DynamicResource Session_Title}">

    <Window.Resources>
        <Style x:Key="SessionSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextTertiaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ActiveBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SessionCloseButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Surface" Property="BorderThickness" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource WindowBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBackgroundBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,12">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Session_Title}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtRange"
                                   Text=""
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   FlowDirection="LeftToRight"
                                   HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Button x:Name="BtnHeaderClose"
                            Style="{StaticResource SessionCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BtnClose_Click"
                            AutomationProperties.Name="{DynamicResource Session_CloseAutomation}">
                        <Path Data="M1,1 L10,10 M10,1 L1,10"
                              Stroke="{DynamicResource TextTertiaryBrush}"
                              StrokeThickness="1.3"
                              Width="11" Height="11"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False"
                          IsTabStop="False">
                <StackPanel Margin="20,16,20,18">
                    <TextBlock x:Name="TxtSampleMeta"
                               Text=""
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Session_CpuPeak}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10.5"/>
                                <TextBlock x:Name="TxtCpuPeak"
                                           Text="--"
                                           Foreground="{DynamicResource CpuAccentBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtCpuAverage"
                                           Text=""
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10.5"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Session_GpuPeak}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10.5"/>
                                <TextBlock x:Name="TxtGpuPeak"
                                           Text="--"
                                           Foreground="{DynamicResource GpuAccentBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtGpuAverage"
                                           Text=""
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10.5"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Session_HotspotPeak}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10.5"/>
                                <TextBlock x:Name="TxtHotspotPeak"
                                           Text="--"
                                           Foreground="{DynamicResource CoolingOnTextBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtHotspotDetail"
                                           Text=""
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10.5"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2"
                                Grid.Column="2"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Session_TimeAbove}"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           FontSize="10.5"/>
                                <TextBlock x:Name="TxtTimeAbove"
                                           Text="--"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           FlowDirection="LeftToRight"
                                           HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtTimeAboveDetail"
                                           Text=""
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Text="{DynamicResource Session_ThermalSection}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,20,0,4"/>
                    <StackPanel x:Name="ThermalPanel"/>

                    <TextBlock Text="{DynamicResource Session_TimelineSection}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,20,0,4"/>
                    <TextBlock x:Name="TxtTimelineEmpty"
                               Text="{DynamicResource Session_TimelineEmpty}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="TimelinePanel"/>

                    <TextBlock Text="{DynamicResource Session_UpdatesSection}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,20,0,4"/>
                    <TextBlock x:Name="TxtUpdatesEmpty"
                               Text="{DynamicResource Session_UpdatesEmpty}"
                               Foreground="{DynamicResource TextMutedBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Margin="0,5,0,0"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="UpdatesPanel"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus"
                               Text=""
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,12,0"
                               AutomationProperties.LiveSetting="Polite"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnCopyReport"
                                Content="{DynamicResource Session_CopyReport}"
                                Style="{StaticResource SessionSecondaryButton}"
                                Click="BtnCopyReport_Click"
                                Margin="0,0,8,0"
                                TabIndex="1"/>
                        <Button x:Name="BtnRefresh"
                                Content="{DynamicResource Session_Refresh}"
                                Style="{StaticResource SessionSecondaryButton}"
                                Click="BtnRefresh_Click"
                                Margin="0,0,8,0"
                                TabIndex="2"/>
                        <Button x:Name="BtnClose"
                                Content="{DynamicResource Common_Close}"
                                Style="{StaticResource SessionSecondaryButton}"
                                Click="BtnClose_Click"
                                TabIndex="3"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
